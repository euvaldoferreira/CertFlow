{
  "manifest_version": 3,
  "name": "CertFlow - Emissor de Certidões CNPJ",
  "version": "1.5.0",
  "description": "Automatiza a emissão de certidões (Receita Federal, Caixa/FGTS, CNDT/TST) a partir de um CNPJ, salvando os PDFs automaticamente. Usa o Gemini Nano (on-device) para interpretar o resultado da certidão.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "contextMenus",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://servicos.receitafederal.gov.br/*",
    "https://consulta-crf.caixa.gov.br/*",
    "https://cndt-certidao.tst.jus.br/*",
    "https://api-certflow.ecolmea.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CertFlow - Emissor de Certidões",
    "default_icon": {
      "16": "icons/chrome/icon-16.png",
      "32": "icons/chrome/icon-32.png",
      "48": "icons/chrome/icon-48.png",
      "128": "icons/chrome/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/chrome/icon-16.png",
    "32": "icons/chrome/icon-32.png",
    "48": "icons/chrome/icon-48.png",
    "128": "icons/chrome/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://servicos.receitafederal.gov.br/*"],
      "js": ["lib/browser-shim.js", "lib/cnpj.js", "content/common.js", "content/ai.js", "content/rfb-certidoes.js", "content/task-mining.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://consulta-crf.caixa.gov.br/*"],
      "js": ["lib/browser-shim.js", "lib/cnpj.js", "content/common.js", "content/ai.js", "content/caixa-crf.js", "content/task-mining.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://cndt-certidao.tst.jus.br/*"],
      "js": ["lib/browser-shim.js", "lib/cnpj.js", "content/common.js", "content/ai.js", "content/cndt-certidoes.js", "content/task-mining.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
