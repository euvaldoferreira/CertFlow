PORT=3000

# Autenticação: um único usuário admin (sem banco de usuários) — o servidor
# nunca vê nem guarda a senha em texto puro, só o hash.
ADMIN_USERNAME=admin
# Gere o hash com:
#   node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA_AQUI', 10))"
ADMIN_PASSWORD_HASH=

# Segredo usado para assinar os access tokens (JWT) — gere com: openssl rand -hex 32
JWT_ACCESS_SECRET=troque-por-um-valor-aleatorio-longo

# Usada pela análise de IA (POST /api/analyze, auto-análise em POST /api/logs,
# e leitura de captcha em POST /api/captcha/solve). Gere uma chave em
# https://aistudio.google.com/apikey — sem ela, esses endpoints continuam
# respondendo, só a IA fica indisponível.
GEMINI_API_KEY=...
