{
  "manifest_version": 3,
  "name": "CertFlow - Emissor de Certidões CNPJ",
  "version": "1.2.0",
  "description": "Automatiza a emissão da Certidão de Regularidade Fiscal (Receita Federal) e do Certificado de Regularidade do FGTS (Caixa) a partir de um CNPJ, salvando os PDFs automaticamente.",
  "browser_specific_settings": {
    "gecko": {
      "id": "certflow@ebf.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "https://servicos.receitafederal.gov.br/*",
    "https://consulta-crf.caixa.gov.br/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CertFlow - Emissor de Certidões",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "background": {
    "scripts": ["lib/cnpj.js", "background.js"]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://servicos.receitafederal.gov.br/*"],
      "js": ["lib/cnpj.js", "content/common.js", "content/rfb-certidoes.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://consulta-crf.caixa.gov.br/*"],
      "js": ["lib/cnpj.js", "content/common.js", "content/caixa-crf.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
